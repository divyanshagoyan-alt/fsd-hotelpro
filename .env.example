# HotelPro — Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Frontend API base URL (Express backend)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to "false" to use real MongoDB API calls, or "true" for standalone frontend mock mode
VITE_USE_MOCK=false

# App environment
VITE_APP_ENV=development

# Backend Server Port
PORT=5000

# MongoDB Connection String (Local Offline MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro
